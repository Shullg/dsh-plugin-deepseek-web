{
  "name": "@local/dsh-plugin-deepseek-web",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek 网页版 DSH 侧边栏插件：在 DSH 左侧 Activity Bar 注册一个图标，点击后在右侧面板用 Electron 隔离 <webview> 打开 chat.deepseek.com，并持久化网页登录态、跟随 DSH 明暗主题。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "electron",
    "webview",
    "sidebar"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/finalize.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node scripts/check.mjs",
    "test": "npm run typecheck && npm run check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "manifest.yaml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": "^0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
